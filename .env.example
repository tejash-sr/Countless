# Copy this file to .env.local and fill it in. .env.local is gitignored; never commit it.

# --- PayPal sandbox REST app ---------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your app
# The app must belong to a UNITED STATES sandbox business account.
# In the app's settings, enable "Vault" (save payment methods) and "Payouts".
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox BUSINESS account that gets paid in the demo (the repair shop).
# Testing Tools > Sandbox Accounts. Country United States, currency USD.
SANDBOX_VENDOR_EMAIL=
# Second business account, used later for the rent flow.
SANDBOX_LANDLORD_EMAIL=

# How saved donor pledges are used. IMMEDIATE is PayPal's documented default.
PAYPAL_VAULT_USAGE_PATTERN=IMMEDIATE

# --- AI (Groq, free plan) -------------------------------------------------
# console.groq.com > API Keys > Create API Key. Free plan limits are per model.
GROQ_API_KEY=
# Reads bills (text and photos). Must accept images: see console.groq.com/docs/vision
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Runs the PayPal agent (tool calling).
GROQ_AGENT_MODEL=openai/gpt-oss-120b
